<Window x:Class="UserActivityTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UserActivityTracker.Views"
        Title="User Activity Tracker" Height="500" Width="1024"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Main Tab Control Content -->
        <TabControl x:Name="TabControl" Margin="10">
            <TabItem Header="Users">
                <views:UserFormView DataContext="{Binding UserForm}" />
            </TabItem>
            <TabItem Header="Activities">
                <views:ActivityTypeFormView DataContext="{Binding ActivityForm}" />
            </TabItem>
            <TabItem Header="Activity Log">
                <views:ActivityLogFormView DataContext="{Binding ActivityLogForm}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>