<UserControl x:Class="UserActivityTracker.Views.ActivityLogFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="850">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Main Content Area (Filters + DataGrid) -->
            <ColumnDefinition Width="*" />
            <!-- Right Form Column -->
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Left Area: Split into Filters (Left) and DataGrid (Right) -->
        <Grid Grid.Column="0" Margin="0,0,15,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="15" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Filter Panel on the Left -->
            <GroupBox Grid.Column="0" Header="Filter Logs" Padding="8" VerticalAlignment="Stretch">
                <StackPanel>
                    <!-- User Filter -->
                    <TextBlock Text="User:" FontSize="11" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding Users}" 
                              SelectedItem="{Binding FilterUser}" 
                              DisplayMemberPath="UserName" 
                              IsSynchronizedWithCurrentItem="False" 
                              Margin="0,0,0,10" Height="25" />

                    <!-- Activity Type Filter -->
                    <TextBlock Text="Activity:" FontSize="11" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding ActivityTypes}" 
                              SelectedItem="{Binding FilterActivityType}" 
                              DisplayMemberPath="Name" 
                              IsSynchronizedWithCurrentItem="False" 
                              Margin="0,0,0,10" Height="25" />

                    <!-- Start Date Filter -->
                    <TextBlock Text="From Date:" FontSize="11" Margin="0,0,0,2" />
                    <DatePicker SelectedDate="{Binding FilterStartDate}" Margin="0,0,0,10" />

                    <!-- End Date Filter -->
                    <TextBlock Text="To Date:" FontSize="11" Margin="0,0,0,2" />
                    <DatePicker SelectedDate="{Binding FilterEndDate}" Margin="0,0,0,15" />

                    <!-- Clear Filters Button -->
                    <Button Content="Clear Filters" 
                            Command="{Binding ClearFiltersCommand}" 
                            Padding="5" />
                </StackPanel>
            </GroupBox>

            <!-- DataGrid on the Right of Filters -->
            <DataGrid Grid.Column="2" 
                      ItemsSource="{Binding ActivityLogs}" 
                      SelectedItem="{Binding SelectedActivityLog, UpdateSourceTrigger=PropertyChanged}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="UserName" Binding="{Binding User.UserName}" Width="*" />
                    <DataGridTextColumn Header="User" Binding="{Binding User.FirstName}" Width="*" />
                    <DataGridTextColumn Header="Activity" Binding="{Binding ActivityType.Name}" Width="*" />
                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=yyyy-MM-dd}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Right Column: Create / Edit Form -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <TextBlock Text="Activity Log Form" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />

            <Label Content="User:" />
            <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="UserName" Margin="0,0,0,10" Height="25" IsSynchronizedWithCurrentItem="False" />

            <Label Content="Activity Type:" />
            <ComboBox ItemsSource="{Binding ActivityTypes}" SelectedItem="{Binding SelectedActivityType}" DisplayMemberPath="Name" Margin="0,0,0,10" Height="25" IsSynchronizedWithCurrentItem="False" />

            <Label Content="Date:" />
            <DatePicker SelectedDate="{Binding Date}" Margin="0,0,0,20" />

            <Button Content="Save / Update" Command="{Binding SaveCommand}" Padding="5" Margin="0,0,0,5" />
            <Button Content="Clear / New" Command="{Binding ClearCommand}" Padding="5" Margin="0,0,0,5" />
            <Button Content="Delete Log" Command="{Binding DeleteCommand}" Background="#FFF2F2" Foreground="DarkRed" Padding="5" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</UserControl>